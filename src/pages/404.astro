---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/paths.js';
---

<Base
  title="Page not found"
  description="That page doesn't exist. Head back to the work of Ibrahim Ahmed (SAQR)."
  robots="noindex, follow"
>
  <section class="nf section">
    <div class="wrap wrap--narrow">
      <p class="eyebrow">404 — Lost</p>

      <h1 class="display nf__title">
        This page went
        <em>off-script</em>.
      </h1>

      <p class="lede nf__lede">
        The link that brought you here points at something that no longer exists —
        or never did. The work is still where you left it.
      </p>

      <div class="nf__actions">
        <a class="btn btn--solid btn--lg" href={withBase('/')} data-magnetic="0.22">
          Back to the portfolio
          <span class="btn__arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn--lg" href={withBase('/#work')}>
          See selected work
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 78svh;
    display: flex;
    align-items: center;
  }

  .nf__title {
    margin-block: 0.4em 0.3em;
  }

  .nf__lede {
    margin-bottom: clamp(2rem, 5vh, 3rem);
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
