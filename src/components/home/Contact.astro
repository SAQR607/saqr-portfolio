---
import { site } from '../../data/site.js';
---

<section class="contact section" id="contact" aria-labelledby="contact-title">
  <span class="grid-lines" aria-hidden="true"></span>
  <span class="glow contact__glow" aria-hidden="true"></span>

  <div class="wrap contact__inner">
    <header class="sec-head" data-reveal>
      <p class="eyebrow">04 — Contact</p>
      <h2 class="display contact__title" id="contact-title">
        Let’s make something <em>worth</em> using.
      </h2>
    </header>

    <p class="lede contact__lede" data-reveal>
      Have a product that needs a sharper front-end, a design system, or motion that
      actually earns its place? I’m available for freelance and full-time work.
    </p>

    <div class="contact__actions" data-copy-scope data-reveal>
      <a class="contact__mail" href={`mailto:${site.email}`}>{site.email}</a>

      <div class="contact__btns">
        <a class="btn btn--solid btn--lg" href={`mailto:${site.email}`}>
          Write an email
          <svg class="btn__arrow" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
            <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>

        <button class="btn btn--lg" type="button" data-copy-email>
          <span data-copy-label>Copy email</span>
        </button>
      </div>

      <p class="contact__status mono" role="status" aria-live="polite" data-copy-status></p>
    </div>

    <ul class="contact__facts" data-stagger>
      <li class="fact" data-reveal-child>
        <span class="fact__k">Availability</span>
        <span class="fact__v">{site.availability}</span>
      </li>
      <li class="fact" data-reveal-child>
        <span class="fact__k">Based</span>
        <span class="fact__v">Remote — worldwide</span>
      </li>
      <li class="fact" data-reveal-child>
        <span class="fact__k">Response</span>
        <span class="fact__v">Within 24 hours</span>
      </li>
    </ul>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 13vh, 10rem);
    border-top: 1px solid var(--line);
    background: linear-gradient(to bottom, var(--ink-950), var(--ink-900));
    isolation: isolate;
  }

  .contact__inner {
    position: relative;
    z-index: 2;
  }

  .contact__glow {
    width: clamp(22rem, 44vw, 40rem);
    height: clamp(22rem, 44vw, 40rem);
    left: -10%;
    bottom: -30%;
    background: var(--accent);
    opacity: 0.1;
  }

  .contact__title {
    font-size: clamp(2.5rem, 1rem + 6.4vw, 6rem);
    max-width: 16ch;
  }

  .contact__lede {
    margin-top: clamp(1.25rem, 3vh, 2rem);
  }

  /* ----------------------------------------------------------- email link */
  .contact__actions {
    margin-top: clamp(2.25rem, 6vh, 3.75rem);
  }

  .contact__mail {
    position: relative;
    display: inline-block;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 5.4vw, 4rem);
    line-height: 1.12;
    letter-spacing: -0.03em;
    word-break: break-word;
    color: var(--paper);
    transition: color 0.45s var(--ease);
  }

  .contact__mail::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0.04em;
    width: 100%;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 0.6s var(--ease);
  }

  .contact__mail:hover,
  .contact__mail:focus-visible {
    color: var(--accent);
  }

  .contact__mail:hover::after,
  .contact__mail:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left center;
  }

  .contact__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: clamp(1.75rem, 4vh, 2.5rem);
  }

  .contact__status {
    min-height: 1.3em;
    margin-top: 0.85rem;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  /* -------------------------------------------------------------- fact list */
  .contact__facts {
    display: grid;
    gap: clamp(1rem, 2.5vw, 2rem);
    margin-top: clamp(3rem, 8vh, 5rem);
    padding-top: clamp(1.5rem, 4vh, 2.25rem);
    border-top: 1px solid var(--line);
    grid-template-columns: 1fr;
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .fact__k {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--paper-faint);
  }

  .fact__v {
    font-size: clamp(0.95rem, 1.6vw, 1.05rem);
    color: var(--paper);
  }

  @media (min-width: 640px) {
    .contact__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__mail::after {
      transform: scaleX(1);
      background: var(--line-mid);
    }

    .contact__mail:hover::after {
      background: var(--accent);
    }
  }
</style>
