---
import { toolkit } from '../../data/site.js';
---

<section class="strip" aria-label="Toolkit">
  <div class="marquee">
    <div class="marquee__track">
      {toolkit.map((item) => <span class="marquee__item">{item}</span>)}
    </div>
    <div class="marquee__track" aria-hidden="true">
      {toolkit.map((item) => <span class="marquee__item">{item}</span>)}
    </div>
  </div>
</section>

<style>
  .strip {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(1rem, 2.4vh, 1.5rem);
    background: linear-gradient(to bottom, rgba(242, 239, 233, 0.02), transparent);
  }
</style>
