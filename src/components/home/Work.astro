---
import { withBase } from '../../lib/paths.js';
import { projects } from '../../data/projects.js';
import ProjectPoster from '../ProjectPoster.astro';
---

<section class="work section" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <header class="sec-head sec-head--split" data-reveal>
      <div class="sec-head__text">
        <p class="eyebrow">01 — Selected work</p>
        <h2 class="h2" id="work-title">Six projects. <em>Six</em> design systems.</h2>
      </div>
      <p class="work__note">
        Every project opens into a full case study — palette, typography, motion, stack
        and the reasoning behind each decision.
      </p>
    </header>

    <ul class="work__list" data-work-list data-stagger>
      {
        projects.map((project) => (
          <li class="work__item">
            <a
              class="row"
              href={withBase(`/work/${project.slug}/`)}
              data-work-row
              data-slug={project.slug}
              data-reveal-child
              style={`--ac:${project.accent}`}
              aria-label={`${project.name} — ${project.kind}. View case study.`}
            >
              <span class="row__idx" aria-hidden="true">{project.idx}</span>

              <span class="row__body">
                <span class="row__name">{project.name}</span>
                <span class="row__meta">
                  <span class="row__kind">{project.kind}</span>
                  <span class="row__sep" aria-hidden="true">/</span>
                  <span class="row__year">{project.year}</span>
                </span>
              </span>

              <span class="row__poster">
                <span class="row__poster-inner">
                  <ProjectPoster project={project} size="sm" />
                </span>
              </span>

              <span class="row__arrow" aria-hidden="true">
                <svg viewBox="0 0 20 20" width="18" height="18" focusable="false">
                  <path
                    d="M5 15 15 5M7 5h8v8"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Cursor-following preview (fine pointers only; moved to <body> at runtime) -->
  <div class="follower" data-preview-follower aria-hidden="true">
    {
      projects.map((project) => (
        <div class="follower__slot" data-preview={project.slug}>
          <ProjectPoster project={project} size="lg" />
        </div>
      ))
    }
  </div>
</section>

<style>
  .work {
    padding-block: clamp(4.5rem, 10vh, 8rem);
  }

  .work__note {
    max-width: 24rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--paper-dim);
  }

  /* ------------------------------------------------------------------ list */
  .work__list {
    border-top: 1px solid var(--line);
  }

  .work__item:last-child .row {
    border-bottom: 1px solid var(--line);
  }

  .row {
    --poster-w: clamp(6.5rem, 11vw, 9.5rem);

    position: relative;
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) var(--poster-w) 1.75rem;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 2rem);
    padding-block: clamp(0.9rem, 2.4vw, 1.5rem);
    border-top: 1px solid var(--line);
    isolation: isolate;
    transition: border-color 0.5s var(--ease);
  }

  .work__item:first-child .row {
    border-top: 0;
  }

  /* Accent wash that wipes in from the left */
  .row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--ac) 16%, transparent),
      color-mix(in srgb, var(--ac) 3%, transparent) 55%,
      transparent 82%
    );
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.65s var(--ease);
  }

  .row:hover::before,
  .row:focus-visible::before {
    transform: scaleX(1);
  }

  .row__idx {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    color: var(--paper-faint);
    transition: color 0.4s var(--ease);
  }

  .row__body {
    display: flex;
    flex-direction: column;
    gap: clamp(0.2rem, 0.8vw, 0.45rem);
    min-width: 0;
  }

  .row__name {
    position: relative;
    display: block;
    width: fit-content;
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5.2vw, 3.4rem);
    line-height: 1.04;
    letter-spacing: -0.028em;
    color: var(--paper);
    transition: transform 0.6s var(--ease);
  }

  /* Accent underline that draws in */
  .row__name::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0.06em;
    width: 100%;
    height: 2px;
    background: var(--ac);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.6s var(--ease);
  }

  .row__meta {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-mono);
    font-size: clamp(0.6rem, 1.5vw, 0.7rem);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--paper-faint);
    transition: color 0.4s var(--ease);
  }

  .row__sep {
    color: var(--ac);
    opacity: 0.7;
  }

  .row__poster {
    display: block;
    overflow: hidden;
    border-radius: 6px;
  }

  .row__poster-inner {
    display: block;
    transform-origin: center;
    transition: transform 0.65s var(--ease);
  }

  .row__arrow {
    display: grid;
    place-items: center;
    color: var(--ac);
    opacity: 0;
    transform: translate(-6px, 6px);
    transition:
      opacity 0.45s var(--ease),
      transform 0.45s var(--ease);
  }

  /* -------------------------------------------------------------- hover state */
  .row:hover .row__idx,
  .row:focus-visible .row__idx {
    color: var(--ac);
  }

  .row:hover .row__name,
  .row:focus-visible .row__name {
    transform: translateX(clamp(0.5rem, 2vw, 1.25rem));
  }

  .row:hover .row__name::after,
  .row:focus-visible .row__name::after {
    transform: scaleX(1);
  }

  .row:hover .row__meta,
  .row:focus-visible .row__meta {
    color: var(--paper-dim);
  }

  .row:hover .row__poster-inner,
  .row:focus-visible .row__poster-inner {
    transform: scale(1.07) rotate(-1.4deg);
  }

  .row:hover .row__arrow,
  .row:focus-visible .row__arrow {
    opacity: 1;
    transform: translate(0, 0);
  }

  /* ------------------------------------------------------ cursor-following card */
  .follower {
    position: fixed;
    top: 0;
    left: 0;
    width: clamp(230px, 23vw, 350px);
    aspect-ratio: 4 / 3;
    z-index: 70;
    pointer-events: none;
    opacity: 0;
    filter: drop-shadow(0 34px 60px rgba(0, 0, 0, 0.62));
    will-change: transform, opacity;
  }

  .follower__slot {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }

  .follower__slot.is-active {
    opacity: 1;
  }

  /* ---------------------------------------------------------------- responsive */
  @media (max-width: 700px) {
    .row {
      grid-template-columns: 1.75rem minmax(0, 1fr) 1.5rem;
      --poster-w: 0;
    }

    .row__poster {
      display: none;
    }

    .row:hover .row__name,
    .row:focus-visible .row__name {
      transform: none;
    }
  }

  @media (hover: none), (pointer: coarse) {
    .follower {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .follower {
      display: none;
    }

    .row::before,
    .row__name::after {
      transition: none;
    }
  }
</style>
