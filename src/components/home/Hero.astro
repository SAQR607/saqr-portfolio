---
import { withBase } from '../../lib/paths.js';
import { site, stats } from '../../data/site.js';

const portraitSrc = {
  webp: {
    srcset: [360, 520, 696]
      .map((w) => `${withBase(`/img/portrait-${w}.webp`)} ${w}w`)
      .join(', '),
    sizes: '(min-width: 960px) 34vw, 72vw',
  },
  fallback: withBase('/img/portrait-fallback.png'),
};
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <span class="grid-lines" aria-hidden="true"></span>
  <span class="glow hero__glow" data-parallax="14" aria-hidden="true"></span>

  <div class="wrap hero__inner">
    <div class="hero__copy">
      <p class="eyebrow hero__eyebrow" data-hero-eyebrow>
        Ibrahim Ahmed (SAQR) <span class="hero__eyebrow-sep" aria-hidden="true">/</span>
        Portfolio 2026
      </p>

      <h1 class="h1 hero__title" id="hero-title">
        <span class="line-mask"><span>Design-driven</span></span>
        <span class="line-mask"><span>front-end <em>craft</em>.</span></span>
      </h1>

      <p class="lede hero__lede" data-hero-fade>
        I turn design systems, motion and modern tooling into fast, accessible product
        interfaces — built to feel as considered as they look.
      </p>

      <div class="hero__cta" data-hero-fade>
        <a class="btn btn--solid btn--lg" href={withBase('/#work')} data-magnetic="0.24">
          Selected work
          <svg class="btn__arrow" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false">
            <path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a class="btn btn--lg" href={`mailto:${site.email}`}>Email me</a>
      </div>

      <hr class="hairline hero__rule" data-hero-rule />

      <ul class="hero__stats">
        {
          stats.map((stat) => (
            <li class="stat" data-hero-index>
              <span class="stat__v">{stat.value}</span>
              <span class="stat__l">{stat.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <figure class="hero__portrait" data-hero-portrait>
    <figcaption class="hero__caption">Front-end developer — SAQR</figcaption>
    <span class="hero__portrait-line" aria-hidden="true"></span>
    <picture>
      <source
        type="image/webp"
        srcset={portraitSrc.webp.srcset}
        sizes={portraitSrc.webp.sizes}
      />
      <img
        src={portraitSrc.fallback}
        alt={`Portrait of ${site.fullName}, wearing a grey suit`}
        width="696"
        height="1404"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </figure>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: clamp(5.5rem, 13vh, 8rem);
    padding-bottom: clamp(2rem, 6vh, 4rem);
    isolation: isolate;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero__copy {
    max-width: min(100%, 46rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  /* ------------------------------------------------------------- eyebrow */
  .hero__eyebrow {
    margin-bottom: clamp(1.25rem, 3vh, 2rem);
    color: var(--paper-dim);
  }

  .hero__eyebrow-sep {
    color: var(--accent);
  }

  /* -------------------------------------------------------------- headline */
  .hero__title {
    font-size: clamp(2.85rem, 1rem + 7.4vw, 6.75rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .hero__lede {
    margin-top: clamp(1.35rem, 3vh, 2rem);
    max-width: 34rem;
  }

  /* ----------------------------------------------------------- call to action */
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: clamp(1.75rem, 4vh, 2.75rem);
  }

  /* ----------------------------------------------------------------- stats */
  .hero__rule {
    margin-top: clamp(2.25rem, 6vh, 3.75rem);
    width: min(100%, 40rem);
    background: var(--line-mid);
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.25rem, 4vw, 3rem);
    margin-top: clamp(1.25rem, 3vh, 1.85rem);
    width: min(100%, 40rem);
    justify-content: space-between;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat__v {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.1rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--paper);
  }

  .stat__l {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--paper-faint);
  }

  /* -------------------------------------------------------------- backdrop */
  .hero__glow {
    width: clamp(24rem, 46vw, 42rem);
    height: clamp(24rem, 46vw, 42rem);
    right: -8%;
    top: 8%;
    background: var(--accent);
    opacity: 0.13;
    z-index: 0;
  }

  /* --------------------------------------------------------------- portrait */
  .hero__portrait {
    position: absolute;
    right: clamp(0.5rem, 4vw, 5rem);
    bottom: -8%;
    z-index: 1;
    width: clamp(15rem, 30vw, 27rem);
    margin: 0;
    pointer-events: none;
  }

  .hero__portrait img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 30px 60px rgba(0, 0, 0, 0.55)) contrast(1.03);
  }

  .hero__portrait-line {
    position: absolute;
    left: -1.5rem;
    top: -6%;
    bottom: 0;
    width: 1px;
    background: linear-gradient(to bottom, transparent, var(--line-mid) 22%, var(--accent) 100%);
  }

  .hero__caption {
    position: absolute;
    left: -3rem;
    top: 46%;
    writing-mode: vertical-rl;
    rotate: 180deg;
    translate: 0 -50%;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--paper-faint);
    white-space: nowrap;
    display: none;
  }

  /* -------------------------------------------------------------- responsive */
  @media (min-width: 960px) {
    .hero__copy {
      max-width: min(58%, 46rem);
    }
  }

  @media (min-width: 1180px) {
    .hero__caption {
      display: block;
    }
  }

  @media (max-width: 959px) {
    .hero {
      flex-direction: column;
      align-items: stretch;
      padding-top: clamp(5.5rem, 16vh, 8rem);
    }

    .hero__portrait {
      position: relative;
      right: auto;
      bottom: auto;
      width: min(64vw, 17rem);
      margin: clamp(2rem, 6vh, 3.5rem) 0 0 auto;
      z-index: 1;
    }

    .hero__portrait-line {
      left: -1.25rem;
      top: 0;
    }

    .hero__inner {
      padding-bottom: 0;
    }

    .hero__glow {
      right: -30%;
      top: auto;
      bottom: -10%;
      opacity: 0.11;
    }

    .grid-lines {
      background-size: calc(100% / 4) 100%;
    }
  }

  @media (max-width: 520px) {
    .hero__stats {
      gap: 1rem 1.5rem;
    }

    .hero__portrait {
      width: min(72vw, 15rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__portrait img {
      filter: drop-shadow(0 18px 36px rgba(0, 0, 0, 0.5));
    }
  }
</style>
