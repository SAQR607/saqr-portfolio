---
import { capabilities } from '../../data/site.js';
---

<section class="cap section" id="capabilities" aria-labelledby="cap-title">
  <div class="wrap">
    <header class="sec-head sec-head--split" data-reveal>
      <div class="sec-head__text">
        <p class="eyebrow">03 — Capabilities</p>
        <h2 class="h2" id="cap-title">What I bring to a <em>build</em>.</h2>
      </div>
      <p class="cap__note">
        Four areas I go deep in — usually all four on the same project, because they
        only work when they’re designed together.
      </p>
    </header>

    <ul class="cap__grid" data-stagger>
      {
        capabilities.map((item) => (
          <li class="card" data-reveal-child>
            <span class="card__rule" aria-hidden="true" />
            <span class="card__n" aria-hidden="true">
              {item.n}
            </span>
            <h3 class="card__title">{item.title}</h3>
            <p class="card__body">{item.body}</p>
            <ul class="card__tags">
              {item.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .cap__note {
    max-width: 25rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--paper-dim);
  }

  .cap__grid {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    grid-template-columns: 1fr;
  }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: clamp(0.6rem, 1.4vw, 0.9rem);
    padding: clamp(1.35rem, 3vw, 2rem);
    background: linear-gradient(170deg, rgba(242, 239, 233, 0.035), rgba(242, 239, 233, 0.012));
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
    isolation: isolate;
    transition:
      transform 0.55s var(--ease),
      border-color 0.55s var(--ease),
      background-color 0.55s var(--ease);
  }

  /* Accent rule that draws across the top edge */
  .card__rule {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.6s var(--ease);
  }

  .card__n {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    color: var(--paper-faint);
    transition: color 0.4s var(--ease);
  }

  .card__title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.85rem);
    font-weight: 400;
    line-height: 1.14;
    letter-spacing: -0.02em;
  }

  .card__body {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--paper-dim);
    flex: 1;
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: clamp(0.4rem, 1.2vw, 0.8rem);
  }

  .card__tags .tag {
    font-size: 0.6rem;
    padding: 0.4em 0.8em;
    letter-spacing: 0.1em;
    transition:
      color 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }

  /* ------------------------------------------------------------ hover state */
  .card:hover {
    transform: translateY(-6px);
    border-color: var(--line-mid);
    background: linear-gradient(170deg, rgba(242, 239, 233, 0.06), rgba(242, 239, 233, 0.02));
  }

  .card:hover .card__rule {
    transform: scaleX(1);
  }

  .card:hover .card__n {
    color: var(--accent);
  }

  .card:hover .card__tags .tag {
    color: var(--paper);
    border-color: var(--line-mid);
  }

  @media (min-width: 640px) {
    .cap__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1080px) {
    .cap__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .card:hover {
      transform: translateY(-8px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover {
      transform: none;
    }
  }
</style>
