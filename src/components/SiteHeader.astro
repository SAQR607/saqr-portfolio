---
import { HOME, withBase } from '../lib/paths.js';
import { site, nav } from '../data/site.js';
---

<header class="hdr" data-header>
  <div class="hdr__inner wrap">
    <a class="brand" href={HOME} aria-label={`${site.fullName} — home`}>
      <span class="brand__name">Ibrahim Ahmed</span>
      <span class="brand__tag">(SAQR)</span>
    </a>

    <nav class="nav" aria-label="Primary">
      <ul class="nav__list">
        {
          nav.map((item) => (
            <li>
              <a class="nav__link" href={withBase(item.href)} data-nav-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr__end">
      <a class="hdr__cta btn btn--sm" href={`mailto:${site.email}`}>
        <span class="hdr__cta-dot" aria-hidden="true"></span>
        Let’s talk
      </a>

      <button
        class="burger"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-menu"
      >
        <span class="burger__box" aria-hidden="true"><i></i><i></i></span>
        <span class="sr-only">Open menu</span>
      </button>
    </div>
  </div>
</header>

<div class="menu" id="site-menu" data-menu aria-hidden="true">
  <div class="menu__inner wrap">
    <p class="eyebrow menu__eyebrow">Navigation</p>
    <nav aria-label="Mobile">
      <ul class="menu__list">
        {
          nav.map((item, i) => (
            <li class="menu__item" style={`--i:${i}`}>
              <a class="menu__link" href={withBase(item.href)} data-nav-link>
                <span class="menu__num" aria-hidden="true">0{i + 1}</span>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="menu__item" style={`--i:${nav.length}`}>
          <a class="menu__link menu__link--mail" href={`mailto:${site.email}`}>
            <span class="menu__num" aria-hidden="true">0{nav.length + 1}</span>
            {site.email}
          </a>
        </li>
      </ul>
    </nav>

    <div class="menu__foot">
      <p class="mono dim">{site.role}</p>
      <p class="mono dim">{site.availability}</p>
    </div>
  </div>
</div>

<style>
  /* ---------------------------------------------------------------- header */
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 90;
    transition:
      background-color 0.5s var(--ease),
      border-color 0.5s var(--ease),
      backdrop-filter 0.5s var(--ease);
    border-bottom: 1px solid transparent;
  }

  .hdr.is-scrolled {
    background-color: rgba(10, 10, 12, 0.72);
    backdrop-filter: saturate(140%) blur(14px);
    -webkit-backdrop-filter: saturate(140%) blur(14px);
    border-bottom-color: var(--line);
  }

  .hdr__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: clamp(4rem, 7vh, 4.75rem);
  }

  /* ------------------------------------------------------------- wordmark */
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
    transition: color 0.35s var(--ease);
  }

  .brand:hover {
    color: var(--accent);
  }

  .brand__tag {
    font-family: var(--font-mono);
    font-size: 0.62em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    transform: translateY(-0.15em);
  }

  /* ------------------------------------------------------------ desktop nav */
  .nav {
    display: none;
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: clamp(1.4rem, 2.6vw, 2.4rem);
  }

  .nav__link {
    position: relative;
    font-size: 0.9rem;
    color: var(--paper-dim);
    padding-block: 0.4rem;
    transition: color 0.35s var(--ease);
  }

  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease);
  }

  .nav__link:hover,
  .nav__link[aria-current='true'] {
    color: var(--paper);
  }

  .nav__link:hover::after,
  .nav__link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* --------------------------------------------------------------- right side */
  .hdr__end {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hdr__cta {
    display: none;
    padding: 0.7em 1.3em;
    font-size: 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line-mid);
    align-items: center;
    gap: 0.55em;
    transition:
      border-color 0.4s var(--ease),
      color 0.4s var(--ease),
      background-color 0.4s var(--ease);
  }

  .hdr__cta:hover,
  .hdr__cta:focus-visible {
    border-color: var(--accent);
    color: var(--accent);
  }

  .hdr__cta-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent-glow);
    animation: pulse 2.6s var(--ease-io) infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(233, 161, 59, 0.5);
    }
    70% {
      box-shadow: 0 0 0 7px rgba(233, 161, 59, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(233, 161, 59, 0);
    }
  }

  /* ------------------------------------------------------------------ burger */
  .burger {
    position: relative;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition:
      border-color 0.4s var(--ease),
      background-color 0.4s var(--ease);
  }

  .burger:hover {
    border-color: var(--accent);
  }

  .burger__box {
    display: block;
    width: 17px;
    height: 10px;
    position: relative;
  }

  .burger__box i {
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition:
      transform 0.45s var(--ease),
      opacity 0.3s var(--ease);
  }

  .burger__box i:first-child {
    top: 0;
  }

  .burger__box i:last-child {
    bottom: 0;
  }

  .burger[aria-expanded='true'] .burger__box i:first-child {
    transform: translateY(4.25px) rotate(45deg);
  }

  .burger[aria-expanded='true'] .burger__box i:last-child {
    transform: translateY(-4.25px) rotate(-45deg);
  }

  /* ------------------------------------------------------------------ menu */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 80;
    background: var(--ink-950);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.5s var(--ease),
      visibility 0s linear 0.5s;
    display: flex;
    align-items: center;
    overflow-y: auto;
  }

  .menu.is-open {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transition:
      opacity 0.5s var(--ease),
      visibility 0s;
  }

  .menu__inner {
    padding-block: clamp(6rem, 14vh, 9rem) 3rem;
    width: 100%;
  }

  .menu__eyebrow {
    margin-bottom: clamp(1.75rem, 5vh, 3rem);
  }

  .menu__list {
    display: flex;
    flex-direction: column;
  }

  .menu__item {
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .menu__item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: clamp(0.85rem, 2.6vh, 1.4rem);
    font-family: var(--font-display);
    font-size: clamp(2rem, 9vw, 3.25rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    transform: translateY(110%);
    transition:
      color 0.35s var(--ease),
      transform 0.7s var(--ease);
    transition-delay: 0s;
  }

  .menu.is-open .menu__link {
    transform: translateY(0);
    transition-delay: calc(0.12s + var(--i) * 0.07s);
  }

  .menu__link:hover,
  .menu__link:focus-visible {
    color: var(--accent);
  }

  .menu__num {
    font-family: var(--font-mono);
    font-size: 0.68em;
    letter-spacing: 0.1em;
    color: var(--accent);
    opacity: 0.85;
  }

  .menu__link--mail {
    font-size: clamp(1.15rem, 5vw, 1.75rem);
    word-break: break-word;
  }

  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-top: clamp(2rem, 6vh, 3.5rem);
    font-size: 0.78rem;
  }

  /* --------------------------------------------------------------- breakpoints */
  @media (min-width: 860px) {
    .nav {
      display: block;
    }

    .burger {
      display: none;
    }

    .hdr__cta {
      display: inline-flex;
    }

    .menu {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .brand__tag {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hdr__cta-dot {
      animation: none;
    }

    .menu__link {
      transform: none !important;
    }
  }
</style>
