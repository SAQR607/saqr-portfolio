---
import { projectFonts } from '../../lib/project-fonts.js';
import PosterMark from '../PosterMark.astro';

/**
 * Full-page static preview of a project, drawn entirely in HTML/CSS in that
 * project's own design system — its palette, its typefaces, its layout ideas.
 *
 * Everything inside the frame is sized in `em` against a container-query root
 * (1em = 1% of the frame width), so the whole mockup scales like a screenshot
 * at any size without a single image byte. Decorative only: the frame is
 * aria-hidden and the real story is told by the case-study copy around it.
 */
const { project, variant = 'home' } = Astro.props;
const f = projectFonts(project.slug);

const vars = [
  `--bg:${project.surface}`,
  `--fg:${project.ink}`,
  `--ac:${project.accent}`,
  `--ac-soft:${project.accentSoft}`,
  `--font-d:${f.display}, serif`,
  `--font-b:${f.body}, sans-serif`,
  `--font-m:${f.mono}, monospace`,
  `--fw:${f.weight}`,
].join(';');
---

<div class="mock" style={vars} aria-hidden="true">
  <div class="mock__bar">
    <span class="mock__dots"><i></i><i></i><i></i></span>
    <span class="mock__url">{project.name.toLowerCase().replace(/[^a-z0-9]+/g, '')}.studio</span>
  </div>

  <div class="mock__page">
    {/* ============================ NIMBUS — SaaS landing ============================ */}
    {
      project.slug === 'nimbus' && (
        <div class="pg pg--nimbus">
          <div class="nb">
            <span class="nb__brand">
              <span class="nb__logo" />
              Nimbus
            </span>
            <span class="nb__links">
              <i>Product</i>
              <i>Pricing</i>
              <i>Docs</i>
              <i>Customers</i>
            </span>
            <span class="nb__cta">Start free trial</span>
          </div>

          <div class="hero">
            <span class="hero__badge">New — Session replay is live</span>
            <h3 class="hero__title">
              Cloud analytics
              <br />
              for teams that ship
            </h3>
            <p class="hero__sub">
              Turn raw product events into decisions your whole team can act on — without
              a data team behind every question.
            </p>
            <div class="hero__actions">
              <span class="btn-solid">Start free trial</span>
              <span class="btn-ghost">Book a demo</span>
            </div>

            <div class="frame">
              <div class="frame__head">
                <span class="frame__pill is-on" />
                <span class="frame__pill" />
                <span class="frame__pill" />
                <span class="frame__spacer" />
                <span class="frame__chip">Last 30 days</span>
              </div>
              <div class="frame__body">
                <div class="kpis">
                  <div class="kpi">
                    <span class="kpi__l">Active users</span>
                    <span class="kpi__v">24,318</span>
                    <span class="kpi__d up">+12.4%</span>
                  </div>
                  <div class="kpi">
                    <span class="kpi__l">Retention</span>
                    <span class="kpi__v">61.2%</span>
                    <span class="kpi__d up">+3.1%</span>
                  </div>
                  <div class="kpi">
                    <span class="kpi__l">Avg. session</span>
                    <span class="kpi__v">7m 42s</span>
                    <span class="kpi__d up">+0.8%</span>
                  </div>
                </div>
                <svg class="chart" viewBox="0 0 320 90" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="nbg" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="var(--ac)" stop-opacity="0.28" />
                      <stop offset="100%" stop-color="var(--ac)" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  <path d="M0 68 32 60 64 64 96 48 128 52 160 36 192 40 224 26 256 30 288 18 320 22V90H0Z" fill="url(#nbg)" />
                  <path
                    d="M0 68 32 60 64 64 96 48 128 52 160 36 192 40 224 26 256 30 288 18 320 22"
                    fill="none"
                    stroke="var(--ac)"
                    stroke-width="2"
                    stroke-linejoin="round"
                  />
                  <circle cx="288" cy="18" r="3.5" fill="var(--ac)" />
                </svg>
              </div>
            </div>
          </div>

          <div class="logos">
            {['Vercel', 'Linear', 'Raycast', 'Loom', 'Retool'].map((l) => (
              <span>{l}</span>
            ))}
          </div>

          <div class="bento">
            <div class="bento__card span2">
              <span class="bento__t">Scroll-synced product tour</span>
              <div class="bento__viz bars">
                {[62, 84, 46, 92, 70, 55, 88].map((h) => (
                  <i style={`height:${h}%`} />
                ))}
              </div>
            </div>
            <div class="bento__card">
              <span class="bento__t">Funnels</span>
              <div class="bento__viz funnel">
                <i style="width:100%" />
                <i style="width:72%" />
                <i style="width:48%" />
                <i style="width:31%" />
              </div>
            </div>
            <div class="bento__card">
              <span class="bento__t">Cohorts</span>
              <div class="bento__viz heat">
                {Array.from({ length: 24 }).map((_, i) => (
                  <i style={`opacity:${0.18 + ((i * 7) % 8) / 10}`} />
                ))}
              </div>
            </div>
          </div>
        </div>
      )
    }

    {/* ======================= ATELIER NOIR — e-commerce ======================= */}
    {
      project.slug === 'atelier' && (
        <div class="pg pg--atelier">
          <div class="an">
            <span class="an__links">
              <i>Shop</i>
              <i>Lookbook</i>
            </span>
            <span class="an__brand">ATELIER NOIR</span>
            <span class="an__links right">
              <i>Journal</i>
              <i>Bag (2)</i>
            </span>
          </div>

          <div class="look">
            <span class="look__eyebrow">Autumn / Winter</span>
            <h3 class="look__title">
              Cut close,
              <br />
              worn long.
            </h3>
            <span class="look__cta">Discover the collection →</span>
          </div>

          <div class="spread">
            <span class="spread__label">01 — The collection</span>
            <p class="spread__text">
              Twelve pieces, made in small runs from Italian wool and undyed linen.
              Designed to layer, cut to last.
            </p>
          </div>

          <div class="grid3">
            {[
              ['Wool overcoat', 'Charcoal', '£680'],
              ['Pleated trouser', 'Bone', '£240'],
              ['Silk shirt', 'Ink', '£310'],
            ].map(([name, color, price], i) => (
              <div class="tile" data-i={i}>
                <div class="tile__img">
                  <PosterMark type="monogram" />
                </div>
                <div class="tile__meta">
                  <span class="tile__n">{name}</span>
                  <span class="tile__c">{color}</span>
                  <span class="tile__p">{price}</span>
                </div>
              </div>
            ))}
          </div>

          <div class="strip">
            <span>Free shipping over £200</span>
            <span>Made in Portugal</span>
            <span>Repairs for life</span>
          </div>
        </div>
      )
    }

    {/* ========================= SYNAPSE — AI product ========================= */}
    {
      project.slug === 'synapse' && (
        <div class="pg pg--synapse">
          <div class="sn">
            <span class="sn__brand">
              <PosterMark type="orbit" />
              Synapse
            </span>
            <span class="sn__links">
              <i>Platform</i>
              <i>Pricing</i>
              <i>Docs</i>
              <i>Status</i>
            </span>
            <span class="sn__cta">Get API key</span>
          </div>

          <div class="field" />

          <div class="shero">
            <span class="shero__sys">SYS.STATUS / OPERATIONAL</span>
            <h3 class="shero__t">
              One API.
              <br />
              Every model.
            </h3>
            <p class="shero__p">
              Route each request to the cheapest model that meets your quality bar.
              Predictable latency, one bill.
            </p>

            <div class="term">
              <div class="term__head">
                <i />
                <i />
                <i />
                <span>~/synapse — curl</span>
              </div>
              <pre class="term__body"><span class="c-mut">$</span> curl synapse.sh/v1/route <span class="c-key">-d</span> <span class="c-str">task=summarize</span>
<span class="c-mut">→</span> model   <span class="c-ion">claude-haiku</span>
<span class="c-mut">→</span> latency <span class="c-ion">128ms</span>  cost <span class="c-ion">$0.0004</span>
<span class="c-mut">→</span> <span class="c-lime">ok</span> <span class="c-mut">· routed in 6ms</span></pre>
            </div>
          </div>

          <div class="bench">
            {[
              ['Synapse', 92, true],
              ['Provider A', 61, false],
              ['Provider B', 48, false],
            ].map(([n, w, on]) => (
              <div class="bench__row">
                <span class="bench__n">{n}</span>
                <span class="bench__bar">
                  <i style={`width:${w}%`} class={on ? 'on' : ''} />
                </span>
                <span class="bench__v">{w}</span>
              </div>
            ))}
          </div>
        </div>
      )
    }

    {/* ======================= FORM & CO — creative agency ======================= */}
    {
      project.slug === 'formco' && (
        <div class="pg pg--formco">
          <div class="fc">
            <span class="fc__brand">Form &amp; Co</span>
            <span class="fc__links">
              <i>Work</i>
              <i>Studio</i>
              <i>Services</i>
              <i>Contact</i>
            </span>
            <span class="fc__idx">Ch. 04</span>
          </div>

          <div class="fhero">
            <h3 class="fhero__t">
              We make
              <br />
              identities that
              <br />
              <em>hold up</em> in print.
            </h3>
            <div class="fhero__meta">
              <span>Brand systems</span>
              <span>Editorial design</span>
              <span>Digital</span>
            </div>
          </div>

          <div class="chapter">
            <span class="chapter__n">04</span>
            <span class="chapter__l">Selected work</span>
          </div>

          <div class="index">
            {[
              ['01', 'Marrow Coffee', 'Identity · Packaging'],
              ['02', 'Verso Press', 'Editorial · Web'],
              ['03', 'Halden Bank', 'Rebrand · System'],
              ['04', 'Field Notes Co.', 'Identity · Print'],
            ].map(([n, name, kind]) => (
              <div class="index__row">
                <span class="index__n">{n}</span>
                <span class="index__name">{name}</span>
                <span class="index__kind">{kind}</span>
              </div>
            ))}
          </div>

          <div class="inkband">
            <span>Recognition</span>
            <span>D&amp;AD Wood Pencil · 2025</span>
            <span>Type Directors Club · 2024</span>
          </div>
        </div>
      )
    }

    {/* ========================== PULSE — analytics app ========================== */}
    {
      project.slug === 'pulse' && (
        <div class="pg pg--pulse">
          <div class="app">
            <aside class="side">
              <span class="side__brand">
                <PosterMark type="chart" />
                Pulse
              </span>
              {['Overview', 'Reports', 'Cohorts', 'Events', 'Funnels', 'Settings'].map(
                (item, i) => (
                  <span class:list={['side__i', { on: i === 0 }]}>{item}</span>
                )
              )}
              <span class="side__u">
                <i />
                Ibrahim A.
              </span>
            </aside>

            <div class="appmain">
              <div class="topbar">
                <span class="topbar__t">Traffic overview</span>
                <span class="topbar__range">Jul 01 — Jul 31</span>
              </div>

              <div class="kpigrid">
                {[
                  ['Sessions', '128,402', '+8.2%'],
                  ['Users', '41,893', '+3.4%'],
                  ['Conv. rate', '4.61%', '+0.4%'],
                  ['Avg. value', '$128.40', '−1.1%'],
                ].map(([l, v, d]) => (
                  <div class="kcard">
                    <span class="kcard__l">{l}</span>
                    <span class="kcard__v">{v}</span>
                    <span class:list={['kcard__d', { down: d.startsWith('−') }]}>{d}</span>
                  </div>
                ))}
              </div>

              <div class="panel">
                <div class="panel__head">
                  <span>Sessions by channel</span>
                  <span class="panel__legend">
                    <i class="a" /> Organic
                    <i class="b" /> Paid
                  </span>
                </div>
                <svg class="area" viewBox="0 0 420 110" preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="plg" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#2563EB" stop-opacity="0.22" />
                      <stop offset="100%" stop-color="#2563EB" stop-opacity="0" />
                    </linearGradient>
                  </defs>
                  {[22, 44, 66, 88].map((y) => (
                    <line x1="0" y1={y} x2="420" y2={y} stroke="#E2E8F0" stroke-width="1" />
                  ))}
                  <path
                    d="M0 78 42 70 84 74 126 58 168 62 210 44 252 50 294 34 336 40 378 26 420 30V110H0Z"
                    fill="url(#plg)"
                  />
                  <path
                    d="M0 78 42 70 84 74 126 58 168 62 210 44 252 50 294 34 336 40 378 26 420 30"
                    fill="none"
                    stroke="#2563EB"
                    stroke-width="2.2"
                  />
                  <path
                    d="M0 94 42 90 84 92 126 84 168 86 210 78 252 82 294 72 336 76 378 68 420 70"
                    fill="none"
                    stroke="#F59E0B"
                    stroke-width="2"
                    stroke-dasharray="5 4"
                  />
                </svg>
              </div>

              <div class="table">
                {[
                  ['Organic search', '52,104', '4:12', '+6.1%'],
                  ['Direct', '31,882', '3:48', '+2.0%'],
                  ['Referral', '18,430', '5:02', '+11.4%'],
                ].map(([c, s, d, g]) => (
                  <div class="table__row">
                    <span>{c}</span>
                    <span class="num">{s}</span>
                    <span class="num">{d}</span>
                    <span class="num up">{g}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      )
    }

    {/* ========================== STUDIO SAQR — brand ========================== */}
    {
      project.slug === 'studio' && (
        <div class="pg pg--studio">
          <div class="sb">
            <span class="sb__brand">
              <PosterMark type="seal" />
              Studio Saqr
            </span>
            <span class="sb__links">
              <i>Services</i>
              <i>Work</i>
              <i>Process</i>
              <i>Journal</i>
            </span>
            <span class="sb__cta">Start a project</span>
          </div>

          <div class="shero2">
            <div class="shero2__text">
              <span class="shero2__eyebrow">Positioning &amp; interface</span>
              <h3 class="shero2__t">
                Clarity is
                <br />
                a service.
              </h3>
              <p class="shero2__p">
                We help boutique consultancies say one true thing well — then build the
                site that proves it.
              </p>
              <span class="shero2__cta">Book an intro call →</span>
            </div>
            <div class="shero2__portrait">
              <span class="shero2__ring" />
              <span class="shero2__figure" />
            </div>
          </div>

          <div class="ledger">
            {[
              ['01', 'Positioning', 'Narrative, proof, tone'],
              ['02', 'Identity', 'Marks, type, colour'],
              ['03', 'Interface', 'Design and front-end'],
              ['04', 'Launch', 'Content, QA, handover'],
            ].map(([n, t, d]) => (
              <div class="ledger__row">
                <span class="ledger__n">{n}</span>
                <span class="ledger__t">{t}</span>
                <span class="ledger__d">{d}</span>
              </div>
            ))}
          </div>

          <div class="quote">
            <p>
              “They found the sentence our whole company had been failing to say for
              three years.”
            </p>
            <span>— Client, boutique strategy firm</span>
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
  /* ============================================================ frame ===== */
  .mock {
    --p: 1em; /* 1% of frame width — the mockup's design unit */
    container-type: inline-size;
    font-size: 1cqw;
    background: #17171b;
    border: 1px solid var(--line-mid);
    border-radius: 12px;
    overflow: hidden;
    isolation: isolate;
    box-shadow: 0 30px 70px -30px rgba(0, 0, 0, 0.8);
  }

  .mock__bar {
    display: flex;
    align-items: center;
    gap: 1.4em;
    padding: 1em 1.4em;
    background: #1d1d22;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .mock__dots {
    display: flex;
    gap: 0.5em;
  }

  .mock__dots i {
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.16);
  }

  .mock__url {
    flex: 1;
    max-width: 22em;
    padding: 0.4em 1em;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.06);
    font-family: var(--font-mono);
    font-size: 0.85em;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.42);
  }

  .mock__page {
    background: var(--bg);
    color: var(--fg);
  }

  .pg {
    font-family: var(--font-b);
    font-size: 1.15em;
    line-height: 1.5;
  }

  /* Shared atoms ---------------------------------------------------------- */
  .btn-solid,
  .btn-ghost {
    display: inline-block;
    padding: 0.75em 1.5em;
    border-radius: 99px;
    font-size: 0.82em;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .btn-solid {
    background: var(--ac);
    color: #fff;
  }

  .btn-ghost {
    border: 1px solid color-mix(in srgb, var(--fg) 22%, transparent);
    color: var(--fg);
  }

  /* ==================================================== 01 · Nimbus ====== */
  .pg--nimbus .nb {
    display: flex;
    align-items: center;
    gap: 2em;
    padding: 1.4em 3em;
    background: #fff;
  }

  .nb__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-family: var(--font-d);
    font-weight: 700;
    font-size: 1.15em;
    letter-spacing: -0.02em;
    color: #0b1020;
  }

  .nb__logo {
    width: 1.1em;
    height: 1.1em;
    border-radius: 0.3em;
    background: linear-gradient(135deg, var(--ac), #7c3aed);
  }

  .nb__links {
    display: flex;
    gap: 1.6em;
    margin-left: auto;
    font-size: 0.85em;
    color: #64748b;
  }

  .nb__links i {
    font-style: normal;
  }

  .nb__cta {
    padding: 0.6em 1.2em;
    border-radius: 99px;
    background: var(--ac);
    color: #fff;
    font-size: 0.8em;
    font-weight: 600;
  }

  .pg--nimbus .hero {
    background: #fff;
    text-align: center;
    padding: 3.4em 3em 3em;
  }

  .hero__badge {
    display: inline-block;
    padding: 0.4em 1em;
    border-radius: 99px;
    background: var(--ac-soft);
    color: var(--ac);
    font-size: 0.72em;
    font-weight: 600;
  }

  .hero__title {
    margin: 0.5em 0 0.3em;
    font-family: var(--font-d);
    font-weight: var(--fw);
    font-size: 3.5em;
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: #0b1020;
  }

  .hero__sub {
    max-width: 30em;
    margin: 0 auto;
    font-size: 1em;
    color: #64748b;
  }

  .hero__actions {
    display: flex;
    justify-content: center;
    gap: 0.8em;
    margin-top: 1.6em;
  }

  .frame {
    margin: 2.6em auto 0;
    max-width: 44em;
    border: 1px solid #e6e9f2;
    border-radius: 0.9em;
    background: #f7f8fc;
    overflow: hidden;
    text-align: left;
    box-shadow: 0 1.4em 3em -1em rgba(11, 16, 32, 0.14);
  }

  .frame__head {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.9em 1.2em;
    background: #fff;
    border-bottom: 1px solid #eef1f7;
  }

  .frame__pill {
    width: 4.4em;
    height: 0.85em;
    border-radius: 99px;
    background: #e8ebf3;
  }

  .frame__pill.is-on {
    background: var(--ac);
    opacity: 0.85;
  }

  .frame__spacer {
    flex: 1;
  }

  .frame__chip {
    padding: 0.3em 0.9em;
    border-radius: 99px;
    border: 1px solid #e6e9f2;
    font-size: 0.72em;
    color: #64748b;
  }

  .frame__body {
    padding: 1.2em;
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8em;
  }

  .kpi {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    padding: 0.9em 1em;
    border: 1px solid #eef1f7;
    border-radius: 0.6em;
    background: #fff;
  }

  .kpi__l {
    font-size: 0.66em;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #94a3b8;
  }

  .kpi__v {
    font-weight: 600;
    font-size: 1.35em;
    letter-spacing: -0.01em;
    color: #0b1020;
  }

  .kpi__d {
    font-size: 0.68em;
    font-weight: 600;
  }

  .kpi__d.up {
    color: #34d399;
  }

  .chart {
    display: block;
    width: 100%;
    height: 6.5em;
    margin-top: 1em;
  }

  .logos {
    display: flex;
    justify-content: center;
    gap: 3em;
    padding: 1.8em;
    background: #fff;
    border-top: 1px solid #eef1f7;
    font-size: 0.8em;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #b3bccd;
  }

  .bento {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 0.9em;
    padding: 2.4em 3em 3em;
    background: #f7f8fc;
  }

  .bento__card {
    padding: 1.2em;
    border: 1px solid #e9ecf5;
    border-radius: 0.8em;
    background: #fff;
  }

  .bento__card.span2 {
    grid-row: span 2;
  }

  .bento__t {
    display: block;
    font-weight: 600;
    font-size: 0.9em;
    color: #0b1020;
  }

  .bento__viz {
    margin-top: 1em;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 0.5em;
    height: 7em;
  }

  .bars i {
    flex: 1;
    border-radius: 0.25em;
